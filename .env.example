# Copia este archivo a .env (no se versiona) y rellena los valores de tu proyecto Firebase.
# Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Reservada: el proyecto tiene Analytics, pero todavía no se integra.
VITE_FIREBASE_MEASUREMENT_ID=

# «1» conecta la app a los emuladores locales (proyecto demo-dya) con login de prueba
# (usuario owner-test). Déjala vacía contra el Firebase real.
VITE_USE_EMULATORS=

# UID del único dueño con permiso de escritura. Lo lee scripts/render-rules.mjs al generar
# firestore.rules (no se expone al navegador). Aparece en Authentication tras tu primer login.
OWNER_UID=
