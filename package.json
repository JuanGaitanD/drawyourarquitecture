{
  "name": "drawyourarquitecture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "og:render": "node scripts/render-og.mjs",
    "rules:render": "node scripts/render-rules.mjs",
    "emulators": "node scripts/render-rules.mjs --emulator && firebase emulators:start --project demo-dya",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@xyflow/react": "12.12.1",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "html-to-image": "1.11.11",
    "lucide-react": "1.69.0",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
